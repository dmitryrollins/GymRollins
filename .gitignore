.DS_Store
.superpowers/
# Xcode
ios/*.xcodeproj/
ios/build/
DerivedData/
*.xcuserstate
xcuserdata/
ios/Config/Local.xcconfig
ios/GymRollins/Info.plist
ios/GymRollinsWidgets/Info.plist
ios/GymRollinsWatch/Info.plist
# Swift Package Manager
.build/
.swiftpm/
.env
.env.*
!.env.example
# Cloudflare Worker (server/): local D1/R2 state and local secrets
server/.wrangler/
server/.dev.vars
# node_modules, also when it is a symlink to another checkout's
node_modules
# personal data never goes in the app repo
*.csv
!**/Fixtures/*.csv
# photo generation run log (scripts/generate-photos.mjs)
docs/media/*.jsonl

# Generated exercise photos live outside the app bundle; they are served from R2 behind the Worker.
/media/
.claude/

# Simulator screenshots stay local (not published)
docs/screenshots/
